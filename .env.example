# Telegram bot token from @BotFather
TELEGRAM_TOKEN=
# Codes users type in the bot to get a role
ACCESS_CODE_ADMIN=
ACCESS_CODE_TECH=
# Optional: a third role that only receives temple light notifications
ACCESS_CODE_PROSFORA=

# Public HTTPS address of the Mini App (e.g. Tailscale Funnel). Leave empty to disable the panel button
WEBAPP_URL=
WEB_PORT=8080
TIMEZONE=Europe/Kyiv

# Folder with devices.json, tinytuya.json and runtime data (default: next to bot.py)
#DATA_DIR=

# Device names exactly as they appear in devices.json
PUMP_SOCKET_NAME=WiFi Socket
LIGHT_RELAY_NAME=DIN-rail relay

# Optional: Tuya cloud device id of a socket at home, used as a "home power" indicator
HOME_LIGHT_DEVICE_ID=

# Stepper driver inputs IN1..IN4 (BCM numbers)
MOTOR_PINS=17,18,27,22
